{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sweetcornna.dev/workflow/contracts/v1/run.schema.json",
  "title": "Agent run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "project_id",
    "template_version",
    "input_version",
    "status",
    "current_step",
    "state_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "template_version": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "input_version": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "paused",
        "waiting_checkpoint",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "current_step": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "problem_analysis",
            "modeling",
            "code_execution",
            "result_verification",
            "visualization",
            "reporting"
          ]
        },
        { "type": "null" }
      ]
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
