{
  "name": "mathmodel-agent-backend",
  "version": "0.2.0",
  "description": "Persistent modeling task core with Codex App Server integration",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "files": [
    "MANIFEST.json",
    "README.md",
    "docs",
    "governance",
    "lib",
    "tests",
    "tools",
    "server",
    "contracts"
  ],
  "scripts": {
    "verify": "npm run build:content-manifest:check && npm run verify:spec-consistency && npm run verify:doc-facts && npm run verify:test-coverage-policy && npm run verify:gate-baselines",
    "verify:doc-facts": "node tools/verify-doc-facts.mjs",
    "verify:doc-facts:write": "node tools/verify-doc-facts.mjs --write",
    "verify:spec-consistency": "node tools/verify-spec-consistency.mjs",
    "verify:test-coverage-policy": "node tools/verify-test-coverage-policy.mjs",
    "verify:gate-baselines": "node tools/verify-gate-baselines.mjs",
    "verify:format": "npx --yes prettier@3.6.2 --check .",
    "build:content-manifest": "node tools/build-content-manifest.mjs --write",
    "build:content-manifest:check": "node tools/build-content-manifest.mjs --check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "start": "node server/main.mjs"
  },
  "private": true
}
